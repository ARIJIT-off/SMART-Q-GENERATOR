{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/exam/(.*)",
      "dest": "/public/exam.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
